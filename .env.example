# Postgres connection string for the orchestrator's database. The values
# below match the credentials in docker-compose.dev.yml, for local dev only.
DATABASE_URL=postgresql://office:office@localhost:5432/office

# Port the event server (packages/server) listens on for hook ingest requests
# and the web app's WebSocket connection.
EVENT_SERVER_PORT=4000

# The service account the orchestrator runs agent sessions as, and that the
# scoped sudoers rule (ticket 007) grants tmux/session control to.
OFFICE_USER=office

# Absolute path to the directory holding checked-out managed project repos,
# one subdirectory per project, that agent sessions are spawned inside.
PROJECT_ROOT=/srv/office/projects

# Max connections in the orchestrator database pool (packages/server/src/db/pool.ts).
# Optional — defaults to 10 if unset.
DATABASE_POOL_SIZE=10

# Postgres statement_timeout in milliseconds, applied to every connection in
# the pool. Optional — defaults to 5000 if unset.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# TLS material for the event server's HTTPS listener (ticket 005) — every
# endpoint in this system is https, loopback included, per the decision
# recorded in docs/tasks/README.md. No default: generate a local dev cert
# and point these at it before starting the server.
TLS_CERT_PATH=/srv/office/tls/dev-cert.pem
TLS_KEY_PATH=/srv/office/tls/dev-key.pem

# Comma-separated tokens the event server (ticket 005) accepts in a hook
# POST's ?token= query parameter. TLS alone does not stop a forged hook
# event (spike 002 finding); this plus binding loopback-only is the
# mitigation. No default — generate one opaque token per role/user before
# starting the server. There is no user table yet, so this is a flat
# accepted-token set, not a token-to-user map (ticket 009 assigns tokens to
# roles when it provisions each one's hook config).
HOOK_INGEST_TOKENS=changeme-generate-a-real-token-per-user

# WebSocket fan-out (ticket 006, packages/server/src/routes/ws.ts). All
# three are optional with sane defaults below — override only to retune
# backpressure, or (in tests) to use a short heartbeat interval so a test
# doesn't wait 60s+ for a real one.

# How often (ms) the server sends an application-level {"type":"ping"} frame
# down /ws. Optional — defaults to 30000 (30s, this ticket's decided
# interval).
WS_HEARTBEAT_INTERVAL_MS=30000

# Consecutive missed pongs (no {"type":"pong"} reply before the next ping is
# due) before the server closes a /ws connection. Optional — defaults to 2.
WS_HEARTBEAT_MAX_MISSED_PONGS=2

# Bytes a /ws connection's outbound send buffer (WebSocket.bufferedAmount)
# may reach before the server treats it as a stuck/slow consumer and
# terminates the connection, so a hook POST is never blocked waiting on a
# client that stopped reading. Optional — defaults to 1000000 (1MB).
WS_BACKPRESSURE_LIMIT_BYTES=1000000

# --- tmux adapter (ticket 007, packages/server/src/orchestrator/tmux.ts) ---

# Comma-separated Linux accounts the orchestrator may pass to `sudo -u`.
# REQUIRED, no default. This is the allowlist that stops a user-supplied
# value ever reaching `sudo -u`: the adapter refuses any account not listed
# here before it spawns anything. It must mirror deploy/sudoers.d/office —
# sudo is the kernel-side boundary, this is the application-side one, and
# neither is trusted to be the only check. The names below are the design's
# example accounts; whether they exist on the target VPS is an open question
# on ticket 007.
TMUX_AGENT_USERS=gluy,user2,user3

# Path to the tmux binary, which must match the sudoers rule BYTE FOR BYTE
# (sudo matches the permitted command as a literal path). Optional —
# defaults to /usr/bin/tmux. Check with `command -v tmux` on the host.
TMUX_BIN=/usr/bin/tmux

# Path to sudo. Optional — defaults to /usr/bin/sudo.
SUDO_BIN=/usr/bin/sudo

# Milliseconds a single tmux invocation may take before it is SIGKILLed and
# reported as a timeout. Optional — defaults to 10000. A tmux client command
# returns in milliseconds; this exists only so a wedged sudo cannot park a
# promise forever.
TMUX_COMMAND_TIMEOUT_MS=10000

# Milliseconds newSession waits for the agent's composer to actually appear
# — which is NOT the same as tmux reporting the session (a folder-trust
# dialog or an onboarding modal sits behind a session tmux calls alive).
# Optional — defaults to 120000, deliberately slack: waiting costs a slow
# spawn, giving up early costs a brief typed into a dialog.
TMUX_READY_TIMEOUT_MS=120000

# Largest message, in bytes, the adapter will deliver. Over this it fails
# loudly rather than truncating. Optional, and NORMALLY LEAVE IT UNSET.
#
# MEASURED 2026-10-07 on the target: tmux refuses a `send-keys` whose WHOLE
# COMMAND exceeds ~16.3 KB, with "command too long". It is a limit on the
# command, not the payload, so the usable message depends on the session
# name — proven constant at 16365 total across name lengths 2, 21, 51 and
# 99. The adapter therefore computes the maximum per session name
# (`maxMessageBytesFor` in shell-quote.ts) and a value set here can only
# LOWER it; it can never raise the ceiling above what tmux will accept.
#
# This used to default to 131072 — Linux MAX_ARG_STRLEN, the kernel's
# ceiling on one execve argument — which is eight times too high. A 100 KB
# brief passed the adapter's own gate and tmux then refused it: loud, so
# nothing was corrupted, but the error named the wrong layer.
# TMUX_MAX_MESSAGE_BYTES=16000

# Geometry of the pane agents are launched into. Optional — default 200x50,
# matching the geometry spike 002's harness drove the TUI at. Not a free
# parameter: pane width changes how Claude Code wraps its output, and the
# readiness check reads the pane.
TMUX_SESSION_COLS=200
TMUX_SESSION_ROWS=50

# --- File-scope locks (ticket 015) -------------------------------------------

# How long an acquired file lock survives without a heartbeat, in seconds.
# REQUIRED, no default — and deliberately so. The TTL is a backstop behind
# SessionEnd, but whether `tmux kill-session` fires SessionEnd through
# `sudo -u` is still unmeasured on the target host (spike 002 measured it
# 8/8 without sudo in the path). If it does not fire there, this number
# stops being a backstop and becomes the primary release path — it decides
# how long a dead agent keeps its files locked. Pick it deliberately.
LOCK_TTL_SECONDS=900

# --- Ticket 008: the session registry ---------------------------------------

# How long startSession waits for the first hook event carrying the session
# id it chose, before marking the row `failed` and killing the desk.
#
# REQUIRED, with no default. This is not a tuning knob — it is the window in
# which the worst failure shape in the system gets caught. The
# https-everywhere decision means an agent launched without
# NODE_EXTRA_CA_CERTS in its environment works PERFECTLY and is completely
# invisible to the orchestrator: every hook fails its TLS handshake, no
# event arrives, and nothing crashes. A desk that looks healthy and reports
# nothing would otherwise sit there spending tokens nobody can see.
#
# Set it from measurement. On the target host a session reached its composer
# in seconds, not milliseconds, and the wall clock was observed stepping
# backwards twice in one session — so a tight value produces false failures.
# Several seconds is the right order; 15000 is a safe starting point.
SESSION_HOOK_ARRIVAL_TIMEOUT_MS=15000

# --- Ticket 010: chat transcript and the turn-end watchdog -------------------

# How long after a turn starts the orchestrator gives up waiting for a
# turn-end event and marks the turn abandoned, so the desk stops showing as
# busy in the chat panel.
#
# REQUIRED, no default — and this one is forced by a measurement. A turn can
# end with NO turn-end event at all: an `Escape` interrupt and a `PreToolUse`
# answered `continue:false` were each observed twice, and neither fires
# `Stop` or `StopFailure`. The only event for an interrupted turn is the
# `UserPromptSubmit` that opened it. So this value is literally how long a
# desk sits "thinking" after somebody hits Escape.
#
# Do NOT derive it from reply latency. The measured figures (20 trials on the
# target: p50 2176 ms, p95 2888 ms) are for a one-word reply and bound
# nothing — a real agent turn runs for minutes. Firing early reports a
# WORKING agent as idle, which is exactly the pane-scraping failure this
# watchdog replaces. 600000 (10 minutes) is a deliberately slack starting
# point; measure a real workload before tightening it.
CHAT_TURN_WATCHDOG_MS=600000

# --- Ticket 009: role definitions and hook provisioning ----------------------

# Account -> hook ingest token, as <user>:<token> pairs. REQUIRED, no default.
#
# HOOK_INGEST_TOKENS above is the flat set the server ACCEPTS; this is the
# assignment the provisioner needs to render one account's hook URLs. Every
# token here must also appear in HOOK_INGEST_TOKENS — provisioning refuses
# otherwise, because the symptom of the two disagreeing is every hook 401ing
# and every session failing its hook gate with nothing naming the mismatch.
#
# At least 16 URL-safe characters ([A-Za-z0-9._~-]) each: the token travels in
# the hook URL's query string, so a character needing escaping would arrive at
# ingest as a different string than was provisioned. Generate with
# `openssl rand -hex 24`, one per account, never shared between accounts — a
# per-account token is what makes a leak rotatable without re-provisioning the
# whole office.
OFFICE_HOOK_TOKENS=agent1:changeme-generate-one-per-account-24-bytes

# https origin of the event server, as it appears in every provisioned hook
# URL. Optional — defaults to https://127.0.0.1:$EVENT_SERVER_PORT, derived so
# the hook URLs cannot disagree with the port the server binds. Must be https
# (the system-wide decision, loopback included) and must not end in a slash.
# OFFICE_EVENT_SERVER_ORIGIN=https://127.0.0.1:4000

# The certificate agents are told to trust, exported into every agent session
# as NODE_EXTRA_CA_CERTS. Optional — defaults to TLS_CERT_PATH, which is right
# whenever the event server's cert is self-signed (it is then its own CA).
# Point it at the CA instead if you issue the server cert from one.
#
# NOT OPTIONAL IN EFFECT: spike 001 §12 measured Claude Code's hook client
# rejecting a self-signed cert outright (`tlsv1 alert unknown ca`), and this
# variable fixing it completely. An agent launched without it works perfectly
# and is completely invisible to the orchestrator.
# OFFICE_AGENT_CA_CERT_PATH=/srv/office/tls/dev-cert.pem

# Provisioning warns when the certificate has fewer than this many days left,
# and refuses outright once it has expired. Optional — defaults to 30. One
# shared certificate means every agent in the office goes silent on the same
# day, and rotating it requires restarting every running agent, so the warning
# has to arrive while someone can still schedule that.
# OFFICE_CERT_MIN_REMAINING_DAYS=30

# Domain for agent git identities (<account>@<domain>). Optional — defaults to
# ai-office.invalid, a reserved TLD that is guaranteed undeliverable, so an
# agent's commits can never mail a real person. Change it only to another
# domain you control and have decided should receive that mail.
# OFFICE_GIT_EMAIL_DOMAIN=ai-office.invalid

# --- Ticket 028: pause, emergency stop and resume ---------------------------

# How long a graceful pause waits for agents to stop on their own before it
# reports which ones did not. Optional — defaults to 30000.
#
# Overshooting is visible and harmless: the pause is already in effect, and
# the deadline only decides when the UI stops saying "waiting" and starts
# naming the agents still mid-turn. Nothing is killed when it expires.
#
# 30 s comes from measurement rather than taste: on the target a reply takes
# p50 2.2 s and p95 2.9 s, and the longest turn observed in the spike ran to
# ~8.6 s. So this covers an ordinary turn several times over without making
# someone watch a spinner for a minute.
# PAUSE_DEADLINE_MS=30000

# Absolute path to the Claude Code binary ON THE AGENT HOST. Required, no
# default, and absolute for two measured reasons:
#
#  - A bare `claude` does not work. tmux runs its command through a
#    NON-interactive shell, and Ubuntu's stock .bashrc returns early when not
#    interactive, so ~/.local/bin never joins PATH. The pane dies instantly
#    with an EMPTY capture, which looks exactly like a slow start.
#  - It is HOST config, not a function of the user. On the target it is a
#    system-wide install and no per-account ~/.local/bin/claude exists, so
#    deriving it from the target user — as ticket 007 first specified — would
#    give ENOENT on every spawn wearing that same empty-capture symptom.
CLAUDE_BIN=/usr/local/bin/claude
