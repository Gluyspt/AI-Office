# Postgres connection string for the orchestrator's database. The values
# below match the credentials in docker-compose.dev.yml, for local dev only.
DATABASE_URL=postgresql://office:office@localhost:5432/office

# Port the event server (packages/server) listens on for hook ingest requests
# and the web app's WebSocket connection.
EVENT_SERVER_PORT=4000

# The service account the orchestrator runs agent sessions as, and that the
# scoped sudoers rule (ticket 007) grants tmux/session control to.
OFFICE_USER=office

# Absolute path to the directory holding checked-out managed project repos,
# one subdirectory per project, that agent sessions are spawned inside.
PROJECT_ROOT=/srv/office/projects

# Max connections in the orchestrator database pool (packages/server/src/db/pool.ts).
# Optional — defaults to 10 if unset.
DATABASE_POOL_SIZE=10

# Postgres statement_timeout in milliseconds, applied to every connection in
# the pool. Optional — defaults to 5000 if unset.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# TLS material for the event server's HTTPS listener (ticket 005) — every
# endpoint in this system is https, loopback included, per the decision
# recorded in docs/tasks/README.md. No default: generate a local dev cert
# and point these at it before starting the server.
TLS_CERT_PATH=/srv/office/tls/dev-cert.pem
TLS_KEY_PATH=/srv/office/tls/dev-key.pem

# Comma-separated tokens the event server (ticket 005) accepts in a hook
# POST's ?token= query parameter. TLS alone does not stop a forged hook
# event (spike 002 finding); this plus binding loopback-only is the
# mitigation. No default — generate one opaque token per role/user before
# starting the server. There is no user table yet, so this is a flat
# accepted-token set, not a token-to-user map (ticket 009 assigns tokens to
# roles when it provisions each one's hook config).
HOOK_INGEST_TOKENS=changeme-generate-a-real-token-per-user

# WebSocket fan-out (ticket 006, packages/server/src/routes/ws.ts). All
# three are optional with sane defaults below — override only to retune
# backpressure, or (in tests) to use a short heartbeat interval so a test
# doesn't wait 60s+ for a real one.

# How often (ms) the server sends an application-level {"type":"ping"} frame
# down /ws. Optional — defaults to 30000 (30s, this ticket's decided
# interval).
WS_HEARTBEAT_INTERVAL_MS=30000

# Consecutive missed pongs (no {"type":"pong"} reply before the next ping is
# due) before the server closes a /ws connection. Optional — defaults to 2.
WS_HEARTBEAT_MAX_MISSED_PONGS=2

# Bytes a /ws connection's outbound send buffer (WebSocket.bufferedAmount)
# may reach before the server treats it as a stuck/slow consumer and
# terminates the connection, so a hook POST is never blocked waiting on a
# client that stopped reading. Optional — defaults to 1000000 (1MB).
WS_BACKPRESSURE_LIMIT_BYTES=1000000

# --- tmux adapter (ticket 007, packages/server/src/orchestrator/tmux.ts) ---

# Comma-separated Linux accounts the orchestrator may pass to `sudo -u`.
# REQUIRED, no default. This is the allowlist that stops a user-supplied
# value ever reaching `sudo -u`: the adapter refuses any account not listed
# here before it spawns anything. It must mirror deploy/sudoers.d/office —
# sudo is the kernel-side boundary, this is the application-side one, and
# neither is trusted to be the only check. The names below are the design's
# example accounts; whether they exist on the target VPS is an open question
# on ticket 007.
TMUX_AGENT_USERS=gluy,user2,user3

# Path to the tmux binary, which must match the sudoers rule BYTE FOR BYTE
# (sudo matches the permitted command as a literal path). Optional —
# defaults to /usr/bin/tmux. Check with `command -v tmux` on the host.
TMUX_BIN=/usr/bin/tmux

# Path to sudo. Optional — defaults to /usr/bin/sudo.
SUDO_BIN=/usr/bin/sudo

# Milliseconds a single tmux invocation may take before it is SIGKILLed and
# reported as a timeout. Optional — defaults to 10000. A tmux client command
# returns in milliseconds; this exists only so a wedged sudo cannot park a
# promise forever.
TMUX_COMMAND_TIMEOUT_MS=10000

# Milliseconds newSession waits for the agent's composer to actually appear
# — which is NOT the same as tmux reporting the session (a folder-trust
# dialog or an onboarding modal sits behind a session tmux calls alive).
# Optional — defaults to 120000, deliberately slack: waiting costs a slow
# spawn, giving up early costs a brief typed into a dialog.
TMUX_READY_TIMEOUT_MS=120000

# Largest message, in bytes, the adapter will deliver. Over this it fails
# loudly rather than truncating. Optional — defaults to 131072, which is
# Linux MAX_ARG_STRLEN (the kernel's ceiling on one execve argument), NOT a
# measurement of what the Claude Code TUI accepts. Spike 002 left the
# payload-size question DEFERRED — every probe from 1000 characters up
# collapsed to a "[Pasted text #N]" placeholder and none was submitted — so
# lower this once the VPS re-measurement produces a real number.
TMUX_MAX_MESSAGE_BYTES=131072

# Geometry of the pane agents are launched into. Optional — default 200x50,
# matching the geometry spike 002's harness drove the TUI at. Not a free
# parameter: pane width changes how Claude Code wraps its output, and the
# readiness check reads the pane.
TMUX_SESSION_COLS=200
TMUX_SESSION_ROWS=50
