{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // The base config targets NodeNext for the server packages. Vite
    // bundles this one, so it needs ESNext modules with bundler resolution
    // — and TypeScript rejects `bundler` unless `module` moves with it.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts"]
}
